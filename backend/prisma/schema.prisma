// Prisma schema for Sagaramati Web

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  designation  String?
  bio          String?  @db.Text
  avatar       String?
  coverImage   String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  danaBookings     DanaBooking[] @relation("UserBookings")
  approvedBookings DanaBooking[] @relation("ApprovedBookings")
  approvedPayments DanaPayment[] @relation("ApprovedPayments")
  financialTransactions FinancialTransaction[] @relation("UserTransactions")
  posts            Post[]
  postLikes        PostLike[]
  postComments     PostComment[]
  savedPosts       SavedPost[]
}

model Post {
  id           Int           @id @default(autoincrement())
  content      String        @db.Text
  mediaUrls    String?       @db.Text // JSON string array of image URLs
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  likes        PostLike[]
  comments     PostComment[]
  savedBy      SavedPost[]

  @@index([userId])
  @@index([createdAt])
}

model PostLike {
  id           Int      @id @default(autoincrement())
  postId       Int
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType String   @default("LIKE") // LIKE (👍), SADHU (☸️), LOVE (❤️)
  createdAt    DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Story {
  id         Int      @id @default(autoincrement())
  title      String?
  imageUrl   String
  authorName String
  userId     Int?
  createdAt  DateTime @default(now())
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

model FinancialTransaction {
  id          Int             @id @default(autoincrement())
  date        DateTime        @default(now())
  description String
  type        TransactionType
  amount      Float
  recordedBy  String          @default("Super Admin")
  userId      Int?
  user        User?           @relation("UserTransactions", fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type])
  @@index([date])
  @@index([userId])
}

model DanaBooking {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  whatsapp  String
  address   String
  month     String
  day       String
  mealType  String   @default("NOON") // MORNING, NOON, EVENING
  purpose   String
  createdAt DateTime @default(now())
  
  status    Status   @default(PENDING)
  
  userId    Int?
  user      User?    @relation("UserBookings", fields: [userId], references: [id])
  
  approvedById Int?
  approvedBy   User? @relation("ApprovedBookings", fields: [approvedById], references: [id])
  
  payments  DanaPayment[]

  @@index([status])
  @@index([month])
  @@index([userId])
  @@index([approvedById])
}

model DanaPayment {
  id                Int         @id @default(autoincrement())
  danaBookingId     Int
  danaBooking       DanaBooking @relation(fields: [danaBookingId], references: [id])
  year              String
  payerName         String
  payerPhone        String
  amount            String
  receiptUrl        String
  punyanumodanaSent Boolean     @default(false)
  createdAt         DateTime    @default(now())

  status            Status      @default(PENDING)
  
  approvedById      Int?
  approvedBy        User?       @relation("ApprovedPayments", fields: [approvedById], references: [id])

  @@index([status])
  @@index([danaBookingId])
  @@index([approvedById])
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  conversationId String   // e.g. "guest_123..." or "user_4"
  senderId       Int?     // User ID if logged in
  senderName     String
  senderRole     String   @default("GUEST") // GUEST, USER, ADMIN, SUPER_ADMIN
  message        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  userRole  String   @default("ADMIN")
  action    String
  target    String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ResidentMonk {
  id          Int      @id @default(autoincrement())
  name        String
  designation String?
  templeName  String?
  photoUrl    String?
  phone       String?
  bio         String?  @db.Text
  category    String   @default("RESIDENT") // CHIEF_NAYAKA, RESIDENT, STUDENT
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String?
  type        String   @default("PHOTO") // PHOTO, VIDEO
  url         String   @db.Text
  description String?  @db.Text
  album       String?  @default("GENERAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([createdAt])
}

model TempleBranch {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("BRANCH") // MAIN, BRANCH
  address     String
  phone1      String?
  phone2      String?
  whatsapp    String?
  email       String?
  history     String?  @db.Text
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}



